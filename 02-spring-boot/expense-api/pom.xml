<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    THE PARENT POM (Phase 1.2) — spring-boot-starter-parent is a curated
    dependency-management BOM: it pins compatible versions for hundreds of
    libraries, so our <dependencies> below need NO version numbers. This is
    Maven's "nearest wins" + dependencyManagement (Java Phase 6.1) at scale.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>dev.ajay</groupId>
  <artifactId>expense-api</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>expense-api</name>
  <description>The Java capstone expense tracker, reborn as a REST API</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <!-- STARTERS (Phase 1.2): each pulls a coherent set of deps transitively.
         web = Spring MVC + embedded Tomcat + Jackson (JSON). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- data-jpa = Spring Data JPA + Hibernate + transactions (Phase 4). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!-- security = Spring Security filter chain, authN/authZ, BCrypt (Phase 7). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- JJWT — create & verify JSON Web Tokens (Phase 7.3). api compile-time,
         impl + jackson at runtime only. -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>0.12.6</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>0.12.6</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>0.12.6</version>
      <scope>runtime</scope>
    </dependency>
    <!-- validation = Bean Validation / Hibernate Validator (Phase 5). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- actuator = production health/metrics endpoints (Phase 8). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- H2 in-memory DB for running/tests (swap for postgresql driver in prod). -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- test starter = JUnit 5 + Spring Test + MockMvc + AssertJ + Mockito (Phase 6). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- security-test = @WithMockUser and security-aware MockMvc helpers. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The Boot plugin builds an executable "fat JAR" (Phase 8) and enables
           `mvn spring-boot:run`. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
