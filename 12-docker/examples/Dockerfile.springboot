# Multi-stage Dockerfile for the Spring Boot capstone (02-spring-boot/expense-api).
# Stage 1 builds the jar with Maven; stage 2 ships only a JRE + the jar — so the
# final image contains no Maven, no source, no build cache (small & secure).

# ---- Stage 1: build ----
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app

# Copy only the POM first and pre-fetch dependencies. Because this layer only
# changes when pom.xml changes, Docker CACHES the downloaded deps across code-only
# rebuilds — the single biggest Dockerfile speed win (layer caching).
COPY pom.xml .
RUN mvn -q dependency:go-offline

# Now copy source and build. Editing source invalidates only from here down.
COPY src ./src
RUN mvn -q clean package -DskipTests

# ---- Stage 2: runtime ----
# A minimal JRE base (not JDK) — smaller attack surface and image size.
FROM eclipse-temurin:21-jre-alpine AS runtime
WORKDIR /app

# Run as a non-root user (security best practice — a container escape is far less
# dangerous without root).
RUN addgroup -S app && adduser -S app -G app
USER app

# Copy ONLY the built jar from the build stage (nothing else crosses over).
COPY --from=build /app/target/*.jar app.jar

# Document the port the app listens on (informational; publish with -p at run time).
EXPOSE 8080

# A healthcheck lets Docker/K8s know the app is actually ready, not just "process up".
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -qO- http://localhost:8080/actuator/health || exit 1

# exec form (JSON array) so the JVM is PID 1 and receives SIGTERM for graceful shutdown.
ENTRYPOINT ["java", "-jar", "app.jar"]
